<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checked arithmetic everywhere: an overflow is an exception that the public entry points turn into a COMBAT_NUMERIC_RANGE refusal, never a wrapped number. -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><CheckForOverflowUnderflow>true</CheckForOverflowUnderflow></PropertyGroup>
  <ItemGroup>
    <!-- The digest of a state or a force list is the one every engine uses (EngineCommon.Digest); the combat rolls keep their own hash because a different one would change every combat outcome. -->
    <ProjectReference Include="../../EngineCommon/EngineCommon.Core/EngineCommon.Core.csproj" />
  </ItemGroup>
</Project>
