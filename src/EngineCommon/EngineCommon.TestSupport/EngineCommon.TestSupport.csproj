<Project Sdk="Microsoft.NET.Sdk">
  <!-- Source rules for tests: checks on the compiler's own syntax trees (Roslyn, syntax only). A test project references this instead of copying the rules; it is not shipped with any game. -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>
