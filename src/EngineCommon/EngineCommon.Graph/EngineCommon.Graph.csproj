<Project Sdk="Microsoft.NET.Sdk">
  <!-- A pure library: integer graphs and the algorithms the engines share (traversal, shortest paths, min-cost flow, label propagation, fixed-point trust iteration, degrees). No clock, no random source, no floating point, no files. Checked arithmetic: an overflow is an exception, never a wrapped number. -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><CheckForOverflowUnderflow>true</CheckForOverflowUnderflow></PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EngineCommon.Graph.Tests" />
  </ItemGroup>
</Project>
