    { "id": "lab.loading", "state": "state.lab.loading", "priority": 30 },
    { "id": "lab.moving", "state": "state.lab.moving", "priority": 40 },
    { "id": "lab.stopped", "state": "state.lab.stopped", "priority": 60 }
