      "work_policy": { "profile": "lab.hauler.work" }
    } }
  ],
  "game_modes": [{ "id": "lab.resource-only", "name": "Resource-only simulation", "properties": {} }],
  "scenarios": [{
    "id": "lab", "name": "Haul lab",
