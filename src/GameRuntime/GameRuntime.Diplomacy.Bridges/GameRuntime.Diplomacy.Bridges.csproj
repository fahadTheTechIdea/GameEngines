<Project Sdk="Microsoft.NET.Sdk">
  <!-- How the diplomacy engine meets the others: the calendar (its day clock, seasons and treaty terms in calendar months and years), the economy (shocks and payments through the existing shock and fund paths), the world-events engine (wars and treaties as its host facts, its signals as political events), the dialogue engine (facts and negotiation outcomes), the tutorial (observations), the AI engine (envoy percepts) and the relationship engine (leaders' regard in, ties out). One class per bridge. -->
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GameRuntime.Diplomacy/GameRuntime.Diplomacy.csproj" />
    <ProjectReference Include="../GameRuntime.Calendar/GameRuntime.Calendar.csproj" />
    <ProjectReference Include="../GameRuntime.Economy/GameRuntime.Economy.csproj" />
    <ProjectReference Include="../GameRuntime.WorldEvents/GameRuntime.WorldEvents.csproj" />
    <ProjectReference Include="../GameRuntime.Dialogue/GameRuntime.Dialogue.csproj" />
    <ProjectReference Include="../GameRuntime.Tutorial/GameRuntime.Tutorial.csproj" />
    <ProjectReference Include="../GameRuntime.AI/GameRuntime.AI.csproj" />
    <ProjectReference Include="../GameRuntime.Relationship/GameRuntime.Relationship.csproj" />
  </ItemGroup>
</Project>
