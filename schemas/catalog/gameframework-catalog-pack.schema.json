{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameFrameWork catalog pack manifest, format 1",
  "description": "pack.json of a resource and recipe pack. Every field is required; nothing is defaulted. Original content only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "version", "title", "language", "world", "genres", "dependencies", "license", "locales", "documents"],
  "properties": {
    "format": { "const": 1 },
    "id": { "$ref": "#/$defs/packId" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "language": { "$ref": "#/$defs/language" },
    "world": { "enum": ["timeless", "historical", "fictional"] },
    "genres": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": { "id": { "$ref": "#/$defs/packId" }, "version": { "$ref": "#/$defs/semver" } }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "provenance", "author"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1, "maxLength": 40 },
        "provenance": { "const": "original" },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "locales": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "document"],
        "properties": { "language": { "$ref": "#/$defs/language" }, "document": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.json$" } }
      }
    },
    "documents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.json$" } }
  },
  "$defs": {
    "packId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8}){0,3}$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$" }
  }
}
